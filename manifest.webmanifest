{
  "name": "Il mondo creativo di Teresa",
  "short_name": "Teresa",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fff8f1",
  "theme_color": "#f6dce6",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./condividi",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "immagini",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/*"
          ]
        }
      ]
    }
  }
}